<?xml version="1.0" encoding="utf-8"?>
<!-- 通信は https のみ（モデルの取得だけが使う）。ユーザーが入れた証明書は信頼しない。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
